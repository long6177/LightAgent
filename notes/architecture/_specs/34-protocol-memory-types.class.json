  "cards": [
    {
      "dot": "cyan",
      "title": "写入链路（用户记忆 source=\"user\"）",
      "items": [
        "run() → _add_memory_context：先取 scoped_user_id() 加命名空间",
        "before_memory_write 钩子可拦截或改写 data",
        "memory_policy.allows_write() → MemoryAdmissionDecision（限流/长度/模式/重复指纹/回调）",
        "MemoryScope(...).to_metadata() 随 data 经 _store_memory_record 交给 memory.store",
        "after_memory_write 钩子 + write_fingerprint 登记去重"
      ]
    },
    {
      "dot": "violet",
      "title": "晋升链路（内部记忆 reflection / delegation 等）",
      "items": [
        "_requires_memory_promotion 命中内部 source/scope 集合即转入候选通道",
        "构造 MemoryCandidate 存入 _memory_promotion_candidates 并记 trace",
        "before_memory_promote 钩子可改写候选或直接给出 decision",
        "memory_policy.allows_promotion() → MemoryPromotionDecision（approve/reject/rewrite/keep）",
        "只有 promotes 为真才 _store_memory_record 落库（injectable=True）；否则状态置 rejected/kept"
      ]
    },
    {
      "dot": "emerald",
      "title": "检索链路（prompt 注入防线）",
      "items": [
        "_retrieve_memory_with_hooks：before/after_memory_retrieve 钩子夹住 memory.retrieve",
        "_filter_memory_results 逐条过 memory_policy.allows_result",
        "未晋升候选（promotion_status=candidate / injectable=False）被 _blocks_prompt_injection 拦下",
        "allowed_sources/scopes/agent_names/trust_levels、min_confidence、expires_at 逐项校验",
        "放行结果注入 \"##用户偏好\" 上下文"
      ]
    },
    {
      "dot": "amber",
      "title": "手动晋升出口",
      "items": [
        "list_memory_candidates() 以 candidate.to_dict() 暴露最近一轮候选",
        "promote_memory_candidate(candidate_id, decision) 按 id 查找候选",
        "decision 为 None → approve；dict/bool/str 经 _coerce_promotion_decision 归一化",
        "最终统一走 _apply_memory_promotion_decision(manual=True)"
      ]
    }
  ]
}
