  "cards": [
    {
      "dot": "cyan", "title": "兼容边界与双轨异步",
      "items": [
        "agent.run('hello') / stream / Hooks / Guardrails / Memory / LightSwarm / LightFlow 保持兼容，runtime 完全 opt-in",
        "arun 非流式用 asyncio.to_thread 隔离同步客户端；astream 以 sentinel 判停并在 finally 归还生成器（core.py:759-787）",
        "原生异步 Provider 与后台 Job 留在调用方事件循环（core.py:760-764）",
        "Session / Capability API 属 pre-1.0 契约：v1.0 冻结前只做 additive 变更（docs/runtime_v010.md）"
      ]
    },
    {
      "dot": "emerald", "title": "事件即持久化",
      "items": [
        "六大管理器只改内存态，统一经 _append → Session.append + store.save（runtime.py:1026）",
        "事件四大性质：append-only、sequence 连续校验、schema_version 版本、凭据字段写前脱敏（session.py:18-28、336）",
        "open_session 按命名空间回放恢复；Job 只恢复档案，未完结立即标 INTERRUPTED（runtime.py:924、688）"
      ]
    },
    {
      "dot": "rose", "title": "收紧原则与长任务韧性",
      "items": [
        "SecurityContext.narrow 只允许收紧资源 / 网络 / 沙箱 / 截止时间 / 风险，不能放宽（security.py:107）",
        "ApprovalToken 绑定 arguments_digest，reusable 默认 False；重复消费验证失败（security.py:208-310）",
        "Job 幂等键去重返回原任务、租约过期不发布结果、恢复递增 fencing epoch（runtime.py:488、641）"
      ]
    }
  ]
