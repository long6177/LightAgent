  "cards": [
    {
      "dot": "cyan",
      "title": "什么时候用 LightFlow",
      "items": [
        "步骤固定、顺序明确的多 Agent 流水线（先调研→写作→审校）",
        "每步就是一个 Agent 的 run()，输入可由 callable 从上一步结果拼装（flow.py:829）",
        "编排器是同步确定性执行，异步入口 arun 走线程（:262）"
      ]
    },
    {
      "dot": "emerald",
      "title": "断点续跑",
      "items": [
        "每步结束写 JSON 存档（_checkpoint:871，每 run 一个文件）",
        "resume() 跳过已成功步骤（:266）；rerun_step() 重跑某步及其全部下游（:300）",
        "注意：超时后后台线程仍在跑，只是结果被丢弃（:766）"
      ]
    },
    {
      "dot": "rose",
      "title": "审批的四种批复（flow.py:932）",
      "items": [
        "approve：照原样继续；edit：改写该步问题后继续（:538）",
        "respond：不调 Agent，人工文字直接当输出（:542）",
        "reject：整条流程标记失败；pending 半途 break 退出等批复（:518）"
      ]
    }
  ]
}