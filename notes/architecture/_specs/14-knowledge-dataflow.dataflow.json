  "cards": [
    {
      "dot": "cyan",
      "title": "两条独立管线",
      "items": [
        "记忆线：对话→策略准入→mem0/共享池→检索注入（core.py:1481-1581）",
        "知识线：文档→滑窗切块→FTS5 双写→bm25 检索带 citation（knowledge.py:145-294）",
        "两线互不依赖：knowledge.py 是能力 Provider，记忆走 MemoryProtocol"
      ]
    },
    {
      "dot": "rose",
      "title": "检索的陷阱",
      "items": [
        "FTS5 检索先超取 10 倍再按 scope/owner 过滤，可能凑不满 limit（knowledge.py:234）",
        "用户 query 原样进 MATCH，特殊字符可能抛 sqlite3 错误（:219）",
        "共享池检索是词面重叠打分，同义改写检索不到（shared_memory.py:191）"
      ]
    }
  ]
