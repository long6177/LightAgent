  "cards": [
    {
      "dot": "cyan",
      "title": "同步 run() 从头等到尾",
      "items": [
        "首轮 create() 是同步 HTTP（core.py:729），调用方线程被占满",
        "工具结果要等 run_async_safely → future.result() 返回（core.py:109）",
        "模型不再返回 tool_calls 才把最终文本交给调用方（core.py:749）"
      ]
    },
    {
      "dot": "rose",
      "title": "dispatch 里藏着四态分支",
      "items": [
        "dispatch 是 async def（tools.py:255），但同步工具被直接调用（tools.py:273-288）",
        "同步生成器透传 Generator，由同步循环消费（core.py:2004-2006）",
        "异步生成器在 dispatch 内收集并序列化为 str（tools.py:276-279）"
      ]
    },
    {
      "dot": "emerald",
      "title": "这一路径没有线程",
      "items": [
        "全程不出现 asyncio.to_thread：同步调用者直接跑在主线程上",
        "工具轮循环上限沿用 max_retry（core.py:1914）",
        "result_format=\"object\" 时最后返回 RunResult，默认返回 str"
      ]
    }
  ]
