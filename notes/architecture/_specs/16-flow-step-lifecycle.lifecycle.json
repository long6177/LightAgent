  "cards": [
    {
      "dot": "cyan",
      "title": "状态在哪里定义（flow.py）",
      "items": [
        "常量 FLOW_PENDING/RUNNING/SUCCESS/FAILED/SKIPPED/WAITING_APPROVAL（:35-40）",
        "主循环 _execute:478：取消检查→构造输入→钩子→审批门→执行→checkpoint",
        "审批 pending 是 break 半途退出，不是阻塞等待（:650）"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复语义",
      "items": [
        "resume() 重跑所有非 success 步骤（:318）",
        "rerun_step() 只重跑指定步骤及其传递下游，并清空下游审批决定（:358/408）",
        "超时用线程池模拟，超时后后台线程仍在跑，只是结果被丢弃（:975）",
        "cancel_if 命中或上游失败会把步骤置为 skipped（flow.py:515/1137）",
        "waiting 批复后经 resume() 回到 running（flow.py:318）"
      ]
    }
  ]
}