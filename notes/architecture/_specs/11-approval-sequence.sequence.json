  "cards": [
    {
      "dot": "rose", "title": "fail-closed 语义",
      "items": [
        "无 reviewer 时存为 pending 并 block——pending 也是拦截，不是等待（review.py:305-312）",
        "reviewer 抛异常按 reject 处理，绝不让未审批动作通过（:317）",
        "approval_id 与当前动作不匹配（哪怕参数差一个空格）都会再次 block（:386）"
      ]
    },
    {
      "dot": "cyan", "title": "四种批复的落地（review.py:428）",
      "items": [
        "approve → continue 放行原动作",
        "edit → replace 替换 arguments 后继续（:432）",
        "respond → block 并以人工答复文本代替动作结果",
        "reject/pending → block，返回 LA-APPROVAL 风格文案"
      ]
    }
  ]
