  "cards": [
    {
      "dot": "cyan",
      "title": "事件即持久化（runtime.py）",
      "items": [
        "Job 全程发 job.created/started/completed/cancelled/failed/interrupted 事件",
        "事件经 AgentRuntime._append 写 Session 并落盘（:806），无独立存储",
        "完成时向 inbox 塞一条 CONTEXT 通知（:516）"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复的边界",
      "items": [
        "open_session 回放 job.* 只重建档案，协程本体不恢复（:564/577）",
        "恢复后未完结任务立即标 INTERRUPTED（:557）",
        "JobManager.start 需要运行中的事件循环，同步上下文会 RuntimeError（:482）"
      ]
    }
